\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces The $3\pi $ invariant mass distribution after applying the $\chi ^{2}_{\mathrm  {KF}} < 24$ selection. The stacked histogram shows the contributions from the signal process $e^{+}e^{-} \to \pi ^{+}\pi ^{-}\pi ^{0}$ and various background processes, including the dominant $e^{+}e^{-} \to \pi ^{+}\pi ^{-}\pi ^{0}\pi ^{0}$ and $e^{+}e^{-} \to \pi ^{+}\pi ^{-}\pi ^{0}\pi ^{0}\gamma _{\text  {ISR}}$ backgrounds.\relax }}{10}{figure.caption.8}\protected@file@percent }
\newlabel{fig:mass3pi_stacked}{{3}{10}{The $3\pi $ invariant mass distribution after applying the $\chi ^{2}_{\mathrm {KF}} < 24$ selection. The stacked histogram shows the contributions from the signal process $e^{+}e^{-} \to \pi ^{+}\pi ^{-}\pi ^{0}$ and various background processes, including the dominant $e^{+}e^{-} \to \pi ^{+}\pi ^{-}\pi ^{0}\pi ^{0}$ and $e^{+}e^{-} \to \pi ^{+}\pi ^{-}\pi ^{0}\pi ^{0}\gamma _{\text {ISR}}$ backgrounds.\relax }{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces The $3\pi $ invariant mass spectrum from selected $e^{+}e^{-} \to \pi ^{+}\pi ^{-}\pi ^{0}\pi ^{0}$ events (red points), overlaid with the scaled Monte Carlo simulation (blue histogram). The distribution is obtained after applying the dual-tag selection criteria and represents the pure $e^{+}e^{-} \to \pi ^{+}\pi ^{-}\pi ^{0}\pi ^{0}$ component in data.\relax }}{11}{figure.caption.9}\protected@file@percent }
\newlabel{fig:4pi_background_spectrum}{{4}{11}{The $3\pi $ invariant mass spectrum from selected $e^{+}e^{-} \to \pi ^{+}\pi ^{-}\pi ^{0}\pi ^{0}$ events (red points), overlaid with the scaled Monte Carlo simulation (blue histogram). The distribution is obtained after applying the dual-tag selection criteria and represents the pure $e^{+}e^{-} \to \pi ^{+}\pi ^{-}\pi ^{0}\pi ^{0}$ component in data.\relax }{figure.caption.9}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}estimate of $e^+e^-\to \pi ^+\pi ^-\pi ^{0}\pi ^{0}\gamma _{\text  {ISR}}$}{11}{subsection.5.2}\protected@file@percent }
